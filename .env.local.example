# Required — one key covers every chain via the Etherscan v2 multichain API
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional. Each chain falls back to viem's public RPC, which works but is rate
# limited — set an override for any chain expected to take real traffic.
# Convention: RPC_URL_<chainId>
# RPC_URL_1=       # Ethereum
# RPC_URL_8453=    # Base
# RPC_URL_42161=   # Arbitrum

# Legacy aliases, still honoured so existing deployments keep working
ETH_RPC_URL=
BASE_RPC_URL=
